# required
PAPERLESS_URL=http://paperless-webserver:8000
PAPERLESS_TOKEN=
ANTHROPIC_API_KEY=
# optional (defaults shown)
MODEL=claude-sonnet-5-5
PROCESSED_TAG=ai-processed
REDO_TAG=ai-redo
FAILED_TAG=ai-failed
EXCLUDE_TAGS=
ALLOW_NEW_TAGS=false
ALLOW_NEW_CORRESPONDENTS=true
ALLOW_NEW_DOCUMENT_TYPES=false
OVERWRITE_TITLE=true
OVERWRITE_CORRESPONDENT=false
OVERWRITE_DOCUMENT_TYPE=true
OVERWRITE_DATE=false
AMOUNT_FIELD=
TAG_CASE=lower
MAX_TAGS=5
BATCH_SIZE=20
INTERVAL_MIN=10
MAX_CONTENT_CHARS=20000
MAX_FAILURES=3
BACKUP_DIR=/data/backups
PORT=8720
LOG_FORMAT=json
