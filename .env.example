# required
PAPERLESS_URL=http://paperless-webserver:8000
# PAPERLESS_PUBLIC_URL=https://paperless.example.org   # for links in the UI, if different from PAPERLESS_URL
PAPERLESS_TOKEN=
ANTHROPIC_API_KEY=
# LLM_PROVIDER=openai          # any OpenAI-compatible API instead of Claude (see README); then set MODEL too
# OPENAI_API_KEY=
# OPENAI_BASE_URL=             # empty = api.openai.com; e.g. http://ollama:11434/v1
# optional (defaults shown)
MODEL=claude-sonnet-5-5
PROCESSED_TAG=ai-processed
REDO_TAG=ai-redo
FAILED_TAG=ai-failed
EXCLUDE_TAGS=
ALLOW_NEW_TAGS=false
ALLOW_NEW_CORRESPONDENTS=true
ALLOW_NEW_DOCUMENT_TYPES=false
OVERWRITE_TITLE=true
OVERWRITE_CORRESPONDENT=false
OVERWRITE_DOCUMENT_TYPE=true
OVERWRITE_DATE=false
AMOUNT_FIELD=
TAG_CASE=lower
MAX_TAGS=5
QUEUE_SINCE=
BATCH_SIZE=20
INTERVAL_MIN=10
MAX_CONTENT_CHARS=20000
MAX_FAILURES=3
BACKUP_DIR=/data/backups
PORT=8720
LOG_FORMAT=json
